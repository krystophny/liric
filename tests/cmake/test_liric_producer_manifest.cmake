foreach(required TOOL INCLUDE ARCHIVE COMPILER RUNTIME_TOOL WORKDIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
set(root "${WORKDIR}/producer_manifest")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
set(manifest "${root}/producer.manifest")
# This fixture identifies its version stub explicitly; LFortran-produced
# program semantics remain a separate acceptance gate.
file(WRITE "${root}/producer.c" "#include <stdio.h>\nint main(void) { puts(\"LFortran build-contract fixture\"); return 0; }\n")
execute_process(COMMAND "${COMPILER}" "${root}/producer.c" -o "${root}/producer"
    RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "cannot build producer contract fixture: ${err}")
endif()
set(arguments --publish "${manifest}" --include "${INCLUDE}"
    --archive "${ARCHIVE}" --compiler "${COMPILER}" --target "fixture-native"
    --runtime "${ARCHIVE}" --runtime-tool "${RUNTIME_TOOL}"
    --producer-llvm "${root}/producer" --producer-liric "${root}/producer")
if(DEFINED SLEEF AND NOT SLEEF STREQUAL "")
    list(APPEND arguments --link-arg "${SLEEF}")
endif()
list(APPEND arguments --link-arg -pthread)
if(UNIX AND NOT APPLE)
    list(APPEND arguments --link-arg -ldl --link-arg -lm --link-arg -no-pie)
endif()
execute_process(COMMAND "${TOOL}" ${arguments}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT out MATCHES "PRODUCER_READY" OR NOT EXISTS "${manifest}")
    message(FATAL_ERROR "public header/archive session smoke failed:\n${out}\n${err}")
endif()
execute_process(COMMAND "${TOOL}" --check "${manifest}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "consumer manifest check failed:\n${out}\n${err}")
endif()
file(READ "${manifest}" good_manifest)

function(reject_manifest label text)
    file(WRITE "${manifest}" "${text}")
    execute_process(COMMAND "${TOOL}" --check "${manifest}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(rc EQUAL 0 OR NOT err MATCHES "PRODUCER_BUILD_FAIL" OR out MATCHES "PRODUCER_READY")
        message(FATAL_ERROR "${label} was not rejected as a producer failure:\n${out}\n${err}")
    endif()
endfunction()

string(REPLACE "include=${INCLUDE}" "include=${root}/missing" bad "${good_manifest}")
reject_manifest("missing public header" "${bad}")
file(WRITE "${root}/broken.a" "not a native archive\n")
string(REPLACE "archive=${ARCHIVE}" "archive=${root}/broken.a" bad "${good_manifest}")
reject_manifest("malformed native archive" "${bad}")
string(REPLACE "runtime=${ARCHIVE}" "runtime=${root}/missing-runtime" bad "${good_manifest}")
reject_manifest("missing runtime" "${bad}")
string(REPLACE "runtime-tool=${RUNTIME_TOOL}" "runtime-tool=${root}/missing-tool" bad "${good_manifest}")
reject_manifest("missing runtime tool" "${bad}")
string(REPLACE "producer-liric=${root}/producer" "producer-liric=${root}/missing-producer" bad "${good_manifest}")
reject_manifest("missing compiler producer" "${bad}")
string(REPLACE "producer-liric=${root}/producer" "producer-liric=${COMPILER}" bad "${good_manifest}")
reject_manifest("wrong compiler producer" "${bad}")
reject_manifest("unsupported manifest epoch" "liric-producer-v99\n")
reject_manifest("duplicate artifact claim" "${good_manifest}archive=${ARCHIVE}\n")
file(WRITE "${manifest}" "${good_manifest}")
set(bad_publish ${arguments})
list(FIND bad_publish --runtime runtime_index)
math(EXPR runtime_value "${runtime_index} + 1")
list(REMOVE_AT bad_publish ${runtime_value})
list(INSERT bad_publish ${runtime_value} "${root}/missing-runtime")
execute_process(COMMAND "${TOOL}" ${bad_publish}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(rc EQUAL 0 OR EXISTS "${manifest}" OR NOT err MATCHES "PRODUCER_BUILD_FAIL")
    message(FATAL_ERROR "failed producer retained stale readiness:\n${out}\n${err}")
endif()
message(STATUS "producer artifact contract: generated session returns 42; broken inputs fail before parity")
